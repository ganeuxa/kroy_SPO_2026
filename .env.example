# Скопируйте этот файл в .env и задайте свои пароли.
# Файл .env в git не попадает (см. .gitignore).

# База данных: владелец схемы (нужен только для создания таблиц и миграций)
POSTGRES_DB=kroy
POSTGRES_USER=kroy_owner
POSTGRES_PASSWORD=change-me-owner

# Пароль роли kroy_app, под которой работает приложение
DB_PASSWORD=change-me-app

# Ключ подписи токенов входа (JWT): длинная случайная строка, например из
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt

# Порты на вашей машине. Поменяйте, если они заняты другим проектом.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

LOG_LEVEL=INFO

# Тестовое окружение (docker-compose.test.yml): порт Nginx на вашей машине.
# TEST_BIND_ADDR=127.0.0.1 — только с этой машины, 0.0.0.0 — из локальной сети.
TEST_HTTP_PORT=8080
TEST_BIND_ADDR=127.0.0.1
