erDiagram
    CART_ITEMS {
        bigint id PK
        bigint user_id FK
        bigint variant_id FK
        int quantity
        timestamptz added_at
    }
    CATEGORIES {
        bigint id PK
        varchar name UK
        varchar slug UK
    }
    FAVORITES {
        bigint user_id PK,FK
        bigint product_id PK,FK
        timestamptz added_at
    }
    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint variant_id FK
        int quantity
        numeric price_at_purchase
    }
    ORDER_STATUS_HISTORY {
        bigint id PK "НОВОЕ"
        bigint order_id FK "НОВОЕ"
        varchar from_status "НОВОЕ"
        varchar to_status "НОВОЕ: new | paid | shipped | delivered | cancelled"
        bigint changed_by FK "НОВОЕ"
        varchar comment "НОВОЕ"
        timestamptz created_at "НОВОЕ"
    }
    ORDERS {
        bigint id PK
        bigint user_id FK
        varchar status "new | paid | shipped | delivered | cancelled"
        numeric total_amount
        varchar delivery_method "courier | pickup"
        varchar delivery_address
        varchar contact_phone
        timestamptz created_at
        bigint pickup_point_id FK "НОВОЕ"
        varchar comment "НОВОЕ"
        timestamptz expires_at "НОВОЕ"
        varchar cancel_reason "НОВОЕ: customer | expired | admin | payment_failed"
        uuid checkout_key "НОВОЕ"
        timestamptz updated_at "НОВОЕ"
    }
    PAYMENTS {
        bigint id PK
        bigint order_id FK
        varchar provider_payment_id UK
        numeric amount
        varchar status "pending | succeeded | failed | cancelled"
        timestamptz created_at
        timestamptz paid_at
        uuid idempotency_key "НОВОЕ"
        varchar provider "НОВОЕ"
        varchar failure_reason "НОВОЕ"
    }
    PICKUP_POINTS {
        bigint id PK "НОВОЕ"
        varchar name "НОВОЕ"
        varchar address UK "НОВОЕ"
        varchar hours "НОВОЕ"
        boolean is_active "НОВОЕ"
    }
    PRODUCT_IMAGES {
        bigint id PK
        bigint product_id FK
        varchar storage_key UK
        varchar color
        smallint sort_order
        varchar content_type "НОВОЕ: image/jpeg | image/png | image/webp"
        int size_bytes "НОВОЕ"
        timestamptz created_at "НОВОЕ"
    }
    PRODUCT_VARIANTS {
        bigint id PK
        bigint product_id FK
        varchar size
        varchar color
        varchar sku UK
        int stock
        boolean is_active "НОВОЕ"
        timestamptz updated_at "НОВОЕ"
    }
    PRODUCTS {
        bigint id PK
        bigint category_id FK
        varchar name
        text description
        varchar gender "men | women | unisex"
        numeric price
        boolean is_active
        timestamptz created_at
        timestamptz updated_at "НОВОЕ"
    }
    REVIEWS {
        bigint id PK
        bigint user_id FK
        bigint product_id FK
        smallint rating
        text body
        timestamptz created_at
    }
    STOCK_MOVEMENTS {
        bigint id PK "НОВОЕ"
        bigint variant_id FK "НОВОЕ"
        int delta "НОВОЕ"
        varchar reason "НОВОЕ: reserve | release | adjust | initial"
        bigint order_id FK "НОВОЕ"
        bigint changed_by FK "НОВОЕ"
        varchar comment "НОВОЕ"
        timestamptz created_at "НОВОЕ"
    }
    USERS {
        bigint id PK
        varchar email UK
        varchar password_hash
        varchar full_name
        varchar phone
        varchar role "customer | admin"
        boolean is_active
        timestamptz created_at
    }
    CATEGORIES ||--o{ PRODUCTS : "содержит"
