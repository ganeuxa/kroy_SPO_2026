      "title": "Name"
     },
     "price": {
      "type": "string",
      "title": "Price"
     },
     "gender": {
      "type": "string",
      "title": "Gender"
     },
     "category": {
      "$ref": "#/components/schemas/CategoryOut"
     },
     "image_key": {
      "anyOf": [
       {
        "type": "string"
