     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "VariantOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "size": {
      "type": "string",
      "title": "Size"
     },
     "color": {
      "type": "string",
      "title": "Color"
     },
     "sku": {
      "type": "string",
      "title": "Sku"
     },
     "stock": {
      "type": "integer",
      "title": "Stock"
     },
     "in_stock": {
      "type": "boolean",
      "title": "In Stock"
     }
    },
    "type": "object",
    "required": [
     "id",
     "size",
     "color",
     "sku",
     "stock",
     "in_stock"
    ],
    "title": "VariantOut"
