{
 "openapi": "3.1.0",
 "info": {
  "title": "Крой API",
  "version": "0.1.0"
 },
 "paths": {
  "/api/health": {
   "get": {
    "tags": [
     "service"
    ],
    "summary": "Health",
    "description": "Жив ли сервер и есть ли связь с БД. Используется в healthcheck контейнера.",
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  },
  "/api/products": {
   "get": {
    "tags": [
     "catalog"
    ],
    "summary": "List Products",
    "operationId": "list_products_api_products_get",
    "parameters": [
     {
      "name": "gender",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "men",
          "women",
          "unisex"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Gender"
      }
     },
     {
      "name": "category",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 80
        },
        {
         "type": "null"
        }
       ],
       "description": "slug категории",
       "title": "Category"
      },
      "description": "slug категории"
     },
     {
      "name": "size",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 10
        },
        {
         "type": "null"
        }
       ],
       "title": "Size"
      }
     },
     {
      "name": "color",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 40
        },
        {
         "type": "null"
        }
       ],
       "title": "Color"
      }
     },
     {
      "name": "price_min",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "minimum": 0.0
        },
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Price Min"
      }
     },
     {
      "name": "price_max",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "minimum": 0.0
        },
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Price Max"
      }
     },
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "minLength": 1,
         "maxLength": 100
        },
        {
         "type": "null"
        }
       ],
       "description": "поиск по названию",
       "title": "Q"
      },
      "description": "поиск по названию"
     },
     {
      "name": "sort",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "new",
        "price_asc",
        "price_desc"
       ],
       "type": "string",
       "default": "new",
       "title": "Sort"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 1,
       "default": 24,
       "title": "Limit"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "Offset"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProductList"
        }
       }
      }
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorOut"
        }
       }
      },
      "description": "Unprocessable Content"
     }
    }
   }
  },
  "/api/products/{product_id}": {
   "get": {
    "tags": [
     "catalog"
    ],
    "summary": "Get Product",
    "operationId": "get_product_api_products__product_id__get",
