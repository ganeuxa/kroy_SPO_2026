    ],
    "summary": "Get Filters",
    "description": "Значения для фильтров каталога: берутся из видимых товаров.",
    "operationId": "get_filters_api_filters_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Filters"
        }
       }
      }
     }
    }
   }
  },
  "/api/auth/register": {
   "post": {
