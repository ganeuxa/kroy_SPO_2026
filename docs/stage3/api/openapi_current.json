     },
     "price_max": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Price Max"
     }
    },
    "type": "object",
    "required": [
     "categories",
     "sizes",
     "colors",
     "price_min",
     "price_max"
    ],
    "title": "Filters",
    "description": "Значения для выпадающих списков фильтров каталога."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
