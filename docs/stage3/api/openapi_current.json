        "schema": {
         "$ref": "#/components/schemas/ErrorOut"
        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   },
   "post": {
    "tags": [
     "cart"
    ],
    "summary": "Add To Cart",
    "description": "Добавляет вариант товара в корзину. Если он уже там, увеличивает количество.",
    "operationId": "add_to_cart_api_cart_post",
    "requestBody": {
     "content": {
      "application/json": {
