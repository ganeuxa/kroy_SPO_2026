        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   }
  },
  "/api/cart": {
   "get": {
    "tags": [
     "cart"
    ],
    "summary": "Get Cart",
    "operationId": "get_cart_api_cart_get",
    "responses": {
     "200": {
      "description": "Successful Response",
