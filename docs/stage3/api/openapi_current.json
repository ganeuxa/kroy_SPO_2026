   },
   "RegisterIn": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 255,
      "format": "email",
      "title": "Email"
     },
     "password": {
      "type": "string",
      "maxLength": 72,
      "minLength": 8,
      "title": "Password"
     },
     "full_name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "title": "Full Name"
     },
     "phone": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^\\+?[0-9]{10,15}$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Phone",
      "examples": [
       "+79001112233"
      ]
     }
    },
    "type": "object",
    "required": [
     "email",
     "password",
     "full_name"
    ],
    "title": "RegisterIn"
   },
   "TokenOut": {
