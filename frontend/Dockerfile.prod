# Образ фронта для тестового окружения (№7).
# Этап 1 собирает статику, этап 2 отдаёт её через Nginx.
# В итоговый образ не попадают Node.js, исходники и node_modules.

# ---------- сборка ----------
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---------- раздача ----------
# Вариант образа Nginx, который работает не от root и слушает порт 8080
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

# Проверка самого Nginx, без обращения к backend
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
